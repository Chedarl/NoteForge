# ─────────────────────────────────────────────────────────────────────────────
# NoteForge environment
#
# Copy to `.env.local` for development. On Vercel, paste the same keys into
# Project → Settings → Environment Variables.
#
# Nothing in this file is optional except where marked. The app refuses to start
# a privileged operation with a missing key rather than guessing.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Postgres. Both come from the Supabase dashboard → Connect.
#   DATABASE_URL — the *transaction pooler* string, with ?pgbouncer=true
#   DIRECT_URL   — the *session pooler* string, used by migrations only
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project. Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Server-only secret key (service role). Never expose this to the browser.
SUPABASE_SECRET_KEY="eyJ..."

# Public origin of this deployment. On Vercel's free tier this is your
# *.vercel.app URL — no custom domain required.
NEXT_PUBLIC_SITE_URL="https://noteforge.vercel.app"

# Exact email address that may receive the platform-admin flag during its first
# self-service signup. Set this before the intended administrator registers.
# An arbitrary "first signup" is never promoted automatically.
PLATFORM_ADMIN_EMAIL="owner@example.com"

# Expiry for PDFs shared through WhatsApp. Clamped to 1–168 hours; default 24.
PDF_SHARE_TTL_HOURS="24"

# Signing key for one-click status-confirmation links sent by email.
# Generate with:  openssl rand -base64 48
CONFIRM_LINK_SECRET=""

# Guards the daily cron route. Vercel sets this header for you when the
# variable exists; generate it the same way.
CRON_SECRET=""

# Salt for hashed rate-limit keys, so a log never contains a bare IP.
RATE_LIMIT_SALT=""

# Encrypts client first names at the column level (AES-256-GCM).
#
# Without it, names cannot be stored at all — the app refuses rather than
# writing one in plaintext. Everything else works: clients are identified by
# their practice code, which is what every screen, filename and export leads
# with anyway.
#
# Generate with:  openssl rand -base64 48
#
# Back this up somewhere other than the database. Lose it and the names are
# unrecoverable; nothing else is affected.
FIELD_ENCRYPTION_KEY=""

# ── Optional: handwriting OCR and draft assistance ──────────────────────────
# Leave KIMI_API_KEY empty and the product still works end to end — photo pages
# simply arrive with no transcript and are typed by hand, which is exactly the
# status quo NoteForge replaces. Nothing breaks; it is only slower.
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.ai/v1"
KIMI_MODEL="kimi-k3"

# ── Optional: outbound email (status alerts, confirmation requests) ──────────
# Without a key, alerts are recorded in-app and logged, never sent.
RESEND_API_KEY=""
EMAIL_FROM="NoteForge <onboarding@resend.dev>"

# ── Seed only ────────────────────────────────────────────────────────────────
# Passwords for the demo accounts created by `npm run db:seed`.
SEED_PASSWORD="ChangeMe!2026"
# ── Optional: WhatsApp delivery of finished PDFs ────────────────────────────
# Meta Cloud API. From the WhatsApp app in your Meta developer dashboard:
#   WHATSAPP_PHONE_NUMBER_ID — the sending number's id, not the number itself
#   WHATSAPP_TOKEN           — a permanent system-user token, not a temporary one
#
# Leave both empty and everything still works: the PDF is built and downloaded
# from the app instead. Nothing is queued and nothing is lost.
#
# Read SECURITY.md before pointing this at real patients. Meta does not sign a
# business associate agreement covering WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
