// NoteForge — data model
//
// Read this file top to bottom and you have the whole product. Three ideas
// carry it:
//
//   1. A Client is a *lifecycle*, not a row. Status changes, and the moment it
//      stops being ACTIVE nothing new may be written against it. That is
//      enforced in `src/lib/clients/guard.ts`, but the shape that makes it
//      enforceable lives here: a status on the client, an append-only event log
//      beside it, and a foreign key from every Submission to the client it
//      claims to be about.
//
//   2. A Submission is what a therapist *hands over* and a Note is what we
//      *produce*. Keeping them as separate rows is what makes turnaround
//      measurable, duplicate detection possible, and the audit answerable —
//      "what did they actually give us" and "what did we write" are different
//      questions and a single table cannot answer both.
//
//   3. Identity is minimised on purpose. There is no `fullName` and no full
//      date of birth. A client is a practice-assigned code and initials. See
//      SECURITY.md for why that is a design decision and not an omission.

generator client {
  provider        = "prisma-client-js"
  // Needed so the trigram index on Submission.normalizedText can be declared in
  // this file rather than hand-written into a migration. When it lives only in
  // SQL, Prisma does not know it exists and every subsequent `migrate diff`
  // proposes dropping it — which is exactly how a production index quietly
  // disappears during an unrelated schema change.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // Ships with Supabase's Postgres, so this is an enable rather than an install.
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy and people
// ─────────────────────────────────────────────────────────────────────────────

/// One therapy practice. Every other row in the database carries a practiceId
/// and every query filters on it, because the alternative — remembering to
/// filter — is how one practice ends up reading another's clients.
model Practice {
  id                 String   @id @default(cuid())
  name               String
  /// Short slug used in client codes, e.g. "RVN" -> RVN-0142.
  code               String   @unique
  /// Optional E.164 number used to prefill the one-button WhatsApp handoff.
  /// It is a staff destination, never a client's phone number.
  noteWriterWhatsApp String?
  /// Hours we promise to turn a submission around in. Drives queue urgency and
  /// the on-time figure in the insights dashboard.
  slaHours           Int      @default(48)
  /// How many days of silence before the daily sweep asks a therapist to
  /// confirm a client is still active.
  staleDays          Int      @default(60)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users               User[]
  clients             Client[]
  submissions         Submission[]
  notes               Note[]
  auditLogs           AuditLog[]
  statusConfirmations StatusConfirmation[]
  shareLinks          ShareLink[]
  fieldLinks          FieldLink[]
  needs               PracticeNeed[]
}

enum UserRole {
  /// Runs the NoteForge account. Sees everything in the practice, manages users.
  OWNER
  /// Your data-entry team. Verifies transcripts, produces and signs notes.
  SPECIALIST
  /// The clinician. Submits encounters, sees only their own clients.
  THERAPIST
  /// A recovery coach or case worker in the field. Submits through a durable
  /// link, never signs in, and sees nothing except the form they were sent.
  /// Deliberately a role rather than a separate table: every guarantee in this
  /// product — the status guardrail, duplicate detection, the audit trail,
  /// attribution on the PDF — is written against `submittedBy` being a User,
  /// and a parallel entity would mean re-implementing all of it.
  FIELD_AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// What kind of clinician is writing.
///
/// This is not decoration. It travels on every submission and into every
/// export, because the note that gets written downstream from a nurse
/// practitioner's encounter is a different document from the one written from a
/// social case worker's — different structure, different vocabulary, different
/// things that must be present. Whatever writes those notes needs to be told
/// which it is looking at, and the only place that can be recorded accurately
/// is at the point the material is submitted.
///
/// It also selects which intake template a clinician is offered, so the right
/// information is *collected* in the first place. An export cannot contain a
/// medication review that nobody was ever asked for.
enum Discipline {
  RECOVERY_COACH
  SOCIAL_CASE_WORKER
  NURSE_PRACTITIONER
  THERAPIST
  COUNSELLOR
  OTHER
}

model User {
  id String @id @default(cuid())

  /// Supabase Auth user id. Authentication is Supabase's job; authorization is
  /// this row's job, re-read on every request so suspending an account takes
  /// effect immediately rather than at the next login.
  ///
  /// Null for a FIELD_AGENT, who submits through a link and never signs in. A
  /// null here is what makes them unable to log in at all: the session lookup
  /// matches on a real Supabase id, which can never equal null. That is the
  /// whole access control, and it fails closed.
  authUserId      String?    @unique
  /// Null for a FIELD_AGENT: a worker given a link has no account and no
  /// mailbox here, and inventing a placeholder address would put a fiction in
  /// the audit trail.
  email           String?    @unique
  fullName        String
  role            UserRole
  status          UserStatus @default(ACTIVE)
  /// Platform-wide access is separate from the practice role. It is never read
  /// from user-editable Supabase metadata and is never granted to an arbitrary
  /// first signup.
  isPlatformAdmin Boolean    @default(false)

  /// Null until the clinician has said which they are. The portal asks on first
  /// use and will not let a submission through without it, because a submission
  /// with no discipline produces an export that cannot be turned into the right
  /// kind of note.
  discipline Discipline?

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients             Client[]             @relation("PrimaryTherapist")
  submissions         Submission[]         @relation("SubmittedBy")
  verifiedPages       SubmissionPage[]     @relation("VerifiedBy")
  resolvedFlags       SubmissionFlag[]     @relation("ResolvedBy")
  authoredNotes       Note[]               @relation("AuthoredBy")
  signedNotes         Note[]               @relation("SignedBy")
  statusEvents        ClientStatusEvent[]  @relation("StatusChangedBy")
  clientsLastTouched  Client[]             @relation("ClientStatusChangedBy")
  statusConfirmations StatusConfirmation[] @relation("ConfirmationTherapist")
  auditLogs           AuditLog[]
  createdShareLinks   ShareLink[]          @relation("ShareCreatedBy")
  fieldLinks          FieldLink[]          @relation("FieldLinkAgent")
  createdFieldLinks   FieldLink[]          @relation("FieldLinkCreatedBy")

  @@index([practiceId, role])
}

// ─────────────────────────────────────────────────────────────────────────────
// Clients and the status lifecycle
// ─────────────────────────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  ON_HOLD
  DISCHARGED
  TRANSFERRED
  DECEASED
}

/// The master client record.
///
/// Deliberately thin on identity: a practice-assigned code, initials, and a
/// birth *year* at most. That is enough for a typist to be certain which person
/// a note belongs to and not enough to identify anyone from a database dump.
model Client {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  /// Human-facing identifier, unique within the practice. This is what appears
  /// on the paper the therapist photographs.
  clientCode String
  initials   String
  /// Year only. A year plus initials plus a practice is a useful disambiguator;
  /// a full date of birth is a direct identifier, so it is not collected.
  birthYear  Int?

  /// The client's first name, encrypted at the column level (AES-256-GCM, see
  /// `src/lib/crypto/field.ts`). Ciphertext in the database, and ciphertext in
  /// a backup or a stolen dump — the key lives in the application environment.
  ///
  /// Stored rather than derived because a caseload of two hundred people cannot
  /// be told apart by initials alone, and a transcriber picking the wrong record
  /// is the failure mode this whole product exists to prevent.
  ///
  /// Never searchable or sortable — that is the accepted cost of encrypting it.
  /// Finding a client is done by `clientCode`, which is indexed and not
  /// sensitive; the name is for *confirming* you have the right one.
  givenNameEnc  String?
  /// Surname initial only, in the clear. One letter is not an identifier and
  /// keeping it readable makes "Maria D." renderable without a decrypt on every
  /// row of a list.
  familyInitial String?

  status            ClientStatus @default(ACTIVE)
  /// Why the status is what it is. Required by the app for any non-ACTIVE
  /// status — "discharged" with no reason is how a record becomes unauditable.
  statusReason      String?
  statusChangedAt   DateTime     @default(now())
  statusChangedById String?
  statusChangedBy   User?        @relation("ClientStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)

  primaryTherapistId String?
  primaryTherapist   User?   @relation("PrimaryTherapist", fields: [primaryTherapistId], references: [id], onDelete: SetNull)

  /// Denormalised for the staleness sweep and the engagement metric. Written
  /// whenever a submission is accepted.
  lastEncounterAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents        ClientStatusEvent[]
  submissions         Submission[]
  notes               Note[]
  statusConfirmations StatusConfirmation[]

  @@unique([practiceId, clientCode])
  @@index([practiceId, status])
  @@index([practiceId, primaryTherapistId])
  @@index([primaryTherapistId])
  @@index([statusChangedById])
}

/// Append-only history of every status transition. Nothing updates or deletes a
/// row here. This table is the answer to "when did we find out, and who told
/// us" — the question that started this whole project.
model ClientStatusEvent {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fromStatus ClientStatus?
  toStatus   ClientStatus
  reason     String?
  /// How we learned: THERAPIST_UPDATE, CONFIRMATION_SWEEP, ADMIN, SEED.
  source     String

  changedById String?
  changedBy   User?   @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([changedById])
}

/// A periodic "is this client still active?" question, sent to the therapist
/// who owns the client after a configurable stretch of silence.
model StatusConfirmation {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  therapistId String
  therapist   User   @relation("ConfirmationTherapist", fields: [therapistId], references: [id], onDelete: Cascade)

  /// Status at the moment we asked, so a late reply cannot silently overwrite a
  /// change somebody made in the meantime.
  askedStatus ClientStatus
  respondedAt DateTime?
  /// What they said: CONFIRMED_ACTIVE, or the new status they picked.
  response    String?

  createdAt DateTime @default(now())

  @@index([practiceId, respondedAt])
  @@index([clientId])
  @@index([therapistId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Intake
// ─────────────────────────────────────────────────────────────────────────────

enum SubmissionKind {
  /// Typed into the portal against a template. The path we want people on.
  STRUCTURED
  /// Photographs of handwritten paper. The path that exists because people
  /// will keep doing it.
  PHOTO
}

enum TemplateKind {
  SOAP
  DAP
  BIRP
  NARRATIVE
  /// Psychosocial case management: situation, needs, actions taken, referrals.
  CASE_MANAGEMENT
  /// Nursing/medical encounter: presentation, measures, assessment, medication,
  /// plan. Kept separate from SOAP because the fields a nurse practitioner must
  /// record — and therefore the fields the export must carry — are not the same.
  NURSING
}

enum SubmissionState {
  /// Accepted, nothing done to it yet.
  RECEIVED
  /// Has photo pages whose transcript a human has not confirmed.
  NEEDS_VERIFY
  /// Verified (or born structured) and waiting for a specialist.
  QUEUED
  /// A specialist has it open.
  IN_PROGRESS
  /// A signed note exists.
  DONE
  /// Refused at the door — the client is not accepting submissions.
  BLOCKED
  /// Resolved as a duplicate of, or superseded by, another submission.
  SUPERSEDED
}

/// One encounter as handed over by a therapist.
model Submission {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  kind         SubmissionKind
  templateKind TemplateKind    @default(SOAP)
  state        SubmissionState @default(RECEIVED)

  /// Copied from the submitting user at write time, not joined at read time.
  ///
  /// Deliberately denormalised: a clinician's discipline can change, and a note
  /// written from a 2026 encounter must carry the discipline that applied *then*.
  /// Joining to the user would silently rewrite history the day somebody's role
  /// is corrected.
  discipline Discipline?

  /// When the session happened — not when it was uploaded.
  ///
  /// This is the spine of the whole record. Every export is organised by it,
  /// duplicate detection compares against it, and the gap between it and
  /// `createdAt` is the handover-delay figure on the dashboard. A submission
  /// cannot exist without one.
  encounterDate DateTime

  /// Structured template answers, keyed by field id. Empty for photo intake.
  fields  Json   @default("{}")
  /// Free text as given. For a photo submission this is filled from the verified
  /// page transcripts once a human confirms them.
  rawText String @default("")

  /// sha256 of the normalised text. Exact match is a certain duplicate and
  /// costs one index lookup, so it runs before anything cleverer.
  contentHash    String
  /// Deduplicated, stopword-stripped tokens, space-joined. Backs the Jaccard
  /// comparison in `src/lib/dedupe/similarity.ts` and the pg_trgm index.
  normalizedText String @default("")

  /// Set when this submission was resolved as a duplicate or an update of an
  /// earlier one. The earlier row is never deleted.
  supersedesId String?
  supersedes   Submission?  @relation("Supersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Submission[] @relation("Supersedes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages        SubmissionPage[]
  flags        SubmissionFlag[] @relation("FlagSubject")
  relatedFlags SubmissionFlag[] @relation("FlagRelated")
  note         Note?
  shareLinks   ShareLink[]

  @@index([practiceId, state, createdAt])
  @@index([clientId, encounterDate])
  @@index([practiceId, contentHash])
  @@index([submittedById])
  @@index([supersedesId])
  /// Backs the export, which is always "this client, these session dates".
  @@index([practiceId, encounterDate])
  /// Trigram index over the normalised text. Turns "has anyone already given us
  /// this?" into a sub-second question rather than a table scan that gets slower
  /// every week. GIN rather than GiST: the row is written once per encounter and
  /// read on every intake, so the slower build buys the lookup speed we want.
  @@index([normalizedText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ─────────────────────────────────────────────────────────────────────────────
// Controlled external handoff
// ─────────────────────────────────────────────────────────────────────────────

/// An expiring capability URL for one generated PDF.
///
/// Only a SHA-256 hash of the bearer token is stored, so a database read cannot
/// be turned into a working download link. The PDF itself remains in the private
/// note-exports bucket and can only be retrieved through the token route.
/// A need this practice added on top of the standard list.
///
/// The standard vocabulary is a constant in `src/lib/intake/needs.ts` and is
/// deliberately not stored — a fixed spine is what lets two practices' data be
/// compared, and a copy in every database is a copy that drifts. Only local
/// additions live here.
///
/// Retired rather than deleted, always: a submission filed last year holds the
/// id, and deleting the row would leave that submission rendering a bare slug
/// where a person's housing problem used to be.
model PracticeNeed {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  /// Prefixed `local_` at creation so it can never collide with a standard id,
  /// including one added to the standard list in a future version.
  needId String
  label  String
  hint   String?

  retiredAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([practiceId, needId])
  @@index([practiceId, retiredAt])
}

/// A durable way in for somebody who will never have an account.
///
/// Separate from `ShareLink`, which points *out* at one document and expires in
/// hours. This points *in*, belongs to one named person, and is meant to be
/// saved to a home screen and used every day — so it does not expire, and the
/// control that matters is revocation rather than a clock.
///
/// Rows are kept after revocation. A link is how work entered the practice, and
/// deleting the row would orphan the reason a submission exists.
model FieldLink {
  id String @id @default(cuid())

  /// Only ever the hash. A stolen database backup must not yield working links.
  tokenHash String @unique

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  /// The FIELD_AGENT this link speaks for. Every submission through it is
  /// attributed to them by name, on screen and on the PDF.
  agentId String
  agent   User   @relation("FieldLinkAgent", fields: [agentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("FieldLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  @@index([practiceId, revokedAt])
  @@index([agentId])
  @@index([createdById])
}

model ShareLink {
  id String @id @default(cuid())

  tokenHash String @unique

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  /// The submission this document is anchored to, when there is one.
  ///
  /// Nullable because not every shareable document is a submission. A client
  /// list is a document about a caseload, not about an encounter, and forcing
  /// it to borrow some unrelated submission's id to satisfy a foreign key would
  /// put a lie in the audit trail — "this share was of submission X" when it
  /// was not. A round of several submissions still anchors to its first, which
  /// is a real relationship worth keeping.
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// What kind of document the stored object is: `submission`, `round` or
  /// `roster`. Deliberately a coarse label and never anything about a client —
  /// it is shown on the unauthenticated landing page, so it must be safe to
  /// read by anyone holding the link before they have downloaded anything.
  documentKind String @default("submission")

  createdById String?
  createdBy   User?   @relation("ShareCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// `note-exports/<practiceId>/shares/<random>.pdf`; never a public URL.
  storagePath String
  expiresAt   DateTime
  revokedAt   DateTime?

  downloadCount    Int       @default(0)
  maxDownloads     Int       @default(10)
  lastDownloadedAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([practiceId, submissionId, createdAt])
  @@index([submissionId])
  @@index([createdById])
  @@index([expiresAt, revokedAt])
}

/// One photographed page, its machine transcript, and the human-confirmed text.
///
/// Both are kept. The raw OCR output is what an auditor needs to see when
/// asking whether a transcription error came from the machine or the person.
model SubmissionPage {
  id String @id @default(cuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  pageNumber  Int
  /// `bucket/key` in Supabase Storage. Never a URL — the bucket is private and
  /// reads go through the role-gated media route.
  storagePath String

  /// Raw reader output, exactly as returned.
  ocrText       String?
  /// Per-block text and confidence, so the UI can shade what to distrust.
  ocrBlocks     Json?
  /// Lowest block confidence on the page, 0–1. Below the threshold in
  /// `src/lib/ai/reader.ts` the page cannot be waved through untouched.
  ocrConfidence Float?
  /// Which reader produced it, e.g. "kimi:kimi-k3". Matters when the engine is
  /// swapped and old transcripts need explaining.
  ocrProvider   String?

  /// What a human confirmed. Null until someone has actually looked.
  verifiedText String?
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([submissionId, pageNumber])
  @@index([verifiedById])
}

enum FlagKind {
  /// Byte-identical normalised text for the same client.
  DUPLICATE
  /// Similar enough to be worth a human deciding.
  NEAR_DUPLICATE
  /// Same client, overlapping period, statements that cannot both be true.
  CONFLICT
  /// Submitted against a client not accepting submissions.
  STATUS_BLOCK
  /// OCR was unsure and a human has not yet confirmed the text.
  LOW_CONFIDENCE
}

enum FlagResolution {
  OPEN
  /// Confirmed a duplicate; subject submission superseded.
  DISMISSED_DUPLICATE
  /// Genuinely new material despite the resemblance.
  KEPT_BOTH
  /// Newer submission replaces the older one.
  MARKED_UPDATE
  /// Asked the therapist; waiting.
  NEEDS_CLARIFICATION
  RESOLVED
}

/// A machine's opinion, awaiting a human's decision. Nothing here ever deletes
/// or merges a submission on its own.
model SubmissionFlag {
  id String @id @default(cuid())

  submissionId String
  submission   Submission @relation("FlagSubject", fields: [submissionId], references: [id], onDelete: Cascade)

  relatedSubmissionId String?
  relatedSubmission   Submission? @relation("FlagRelated", fields: [relatedSubmissionId], references: [id], onDelete: SetNull)

  kind   FlagKind
  /// 0–1 similarity where meaningful. Null for STATUS_BLOCK.
  score  Float?
  /// One sentence a human can act on without opening both documents.
  detail String?

  resolution   FlagResolution @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?          @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([submissionId, resolution])
  @@index([kind, resolution])
  @@index([relatedSubmissionId])
  @@index([resolvedById])
}

// ─────────────────────────────────────────────────────────────────────────────
// Production
// ─────────────────────────────────────────────────────────────────────────────

enum NoteState {
  DRAFT
  IN_REVIEW
  /// Signed by a named human. Frozen — further edits create a new version.
  SIGNED
  /// Handed back to the practice.
  DELIVERED
}

model Note {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// One note per submission. A correction is a new version of this note, not a
  /// second note against the same source.
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  templateKind TemplateKind
  /// Template-shaped body, keyed by field id.
  body         Json         @default("{}")
  state        NoteState    @default(DRAFT)

  /// True when a model proposed any of this text. Kept for the record, because
  /// "was a machine involved" is a question a practice is entitled to ask.
  aiAssisted Boolean @default(false)

  authoredById String?
  authoredBy   User?   @relation("AuthoredBy", fields: [authoredById], references: [id], onDelete: SetNull)

  signedById String?
  signedBy   User?     @relation("SignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt   DateTime?

  deliveredAt DateTime?

  /// Bumped on every post-signature edit.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags NoteTag[]

  @@index([practiceId, state])
  @@index([clientId, createdAt])
  @@index([authoredById])
  @@index([signedById])
}

enum TagKind {
  GOAL_PROGRESS
  GOAL_STALLED
  RISK
  ENGAGEMENT_DROP
}

/// A small structured signal attached to a note by the specialist who wrote it.
///
/// This is the entire mechanism behind the clinical half of the insights page.
/// It is a human ticking a box, not a model inferring a trend, and that is the
/// point: a "risk increasing" chart built from an unsupervised classifier is a
/// liability, while one built from what a trained person actually marked is
/// evidence.
model NoteTag {
  id String @id @default(cuid())

  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  kind  TagKind
  /// Free-text label, e.g. "sleep hygiene goal" — never note content.
  label String

  createdAt DateTime @default(now())

  @@index([noteId])
  @@index([kind, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only record of who did what — including who *read* what.
///
/// Reads are logged, not just writes. In a system holding clinical material the
/// question "who looked at this person's file" is asked more often than "who
/// edited it", and a log that only covers writes cannot answer it.
model AuditLog {
  id String @id @default(cuid())

  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Copied at write time so the row still names someone after the user is gone.
  actorName String
  actorRole String

  /// e.g. "client.status_changed", "submission.blocked", "page.viewed",
  /// "note.signed", "insights.exported".
  action      String
  entityType  String
  entityId    String
  /// Something readable that survives the entity, e.g. a client code.
  entityLabel String?

  /// Changed fields as { field: { from, to } }. Never contains note text.
  changes Json?

  createdAt DateTime @default(now())

  @@index([practiceId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}